{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "gMap",
  "position": {
    "x": 8,
    "y": 8,
    "z": 0,
    "width": 740,
    "height": 560,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "map",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimGeography"
                    }
                  },
                  "Property": "State"
                }
              },
              "queryRef": "DimGeography.State",
              "nativeQueryRef": "State"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "_Measures.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Profit Margin"
                }
              },
              "queryRef": "_Measures.Profit Margin",
              "nativeQueryRef": "Profit Margin"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
