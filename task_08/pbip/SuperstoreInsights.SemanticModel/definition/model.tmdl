model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

ref table FactSales
ref table DimDate
ref table DimProduct
ref table DimCustomer
ref table DimGeography
ref table _Measures
ref table TopProducts

annotation PBI_QueryOrder = ["FactSales","DimDate","DimProduct","DimCustomer","DimGeography","_Measures"]
